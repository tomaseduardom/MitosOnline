# Godot 4+ — caché local de importación (se regenera sola al abrir el proyecto)
.godot/
*.translation

# Caché de imágenes de cartas descargadas de la API/CDN (se regenera sola —
# CardDatabase.OFFLINE_MODE las vuelve a descargar y cachear en user://)
cartas_descargadas/

# Exportables
export.cfg
export_credentials.cfg

# Sistema operativo / editor
.DS_Store
Thumbs.db

# Credenciales reales de la API externa de ShadowForge (tools/reload_card.ps1)
# — nunca versionar, solo queda en el disco local.
tools/shadowforge_credentials.local.ps1

# Relay server (Node.js) — dependencias instaladas localmente
relay-server/node_modules/
